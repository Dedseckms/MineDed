{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MineDed",
  "mainBinaryName": "MineDed",
  "identifier": "ru.dedseckms.mineup",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MineDed",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/skins/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "publisher": "Dedseckms",
    "homepage": "https://github.com/Dedseckms/MineDed",
    "license": "GPL-3.0-or-later",
    "category": "Game",
    "shortDescription": "Minecraft launcher",
    "longDescription": "MineDed: cross-platform Minecraft launcher with mod loaders, modpacks, P2P rooms and voice chat.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "nsis/hooks.nsh"
      },
      "wix": {
        "language": ["ru-RU", "en-US"],
        "upgradeCode": "b65e742b-ee38-5c9c-8d5c-b0e6dfca319a"
      }
    },
    "linux": {
      "deb": {
        "section": "games"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxNDZGMjVFMUQzNzJCRjYKUldUMkt6Y2RYdkpHOFpQZHVOY2lvTDM5VTVjRkhEK3phOTBYcm5hR1UvSVF4T2JOZFVvUzFEVFcK",
      "endpoints": [
        "https://github.com/Dedseckms/MineDed/releases/latest/download/latest.json",
        "https://relay.dedseckms.ru/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
