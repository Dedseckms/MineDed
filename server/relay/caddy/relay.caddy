# Site block for the owner's host Caddy (2.6.2). Not active until the owner adds
#   import /opt/relay/caddy/*.caddy
# to /etc/caddy/Caddyfile (next to the skinserver import), validates and reloads.
# Requires DNS A record relay.dedseckms.ru -> the owner's external IP.
# Ports must match /opt/relay/.env (HUB_PORT, RELAY_HTTP_PORT, UPDATES_PORT).
relay.dedseckms.ru {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# hub: rooms API + room WebSocket.
	handle /api/v1/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:18080 {
			# hub rate-limits by X-Real-IP: overwrite so clients cannot spoof it.
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Update mirror (GitHub may be blocked for users): static, read-only, GET/HEAD only.
	handle_path /updates/* {
		@write not method GET HEAD
		respond @write 405
		header /latest.json Cache-Control "no-cache"
		header /status.json Cache-Control "no-cache"
		reverse_proxy 127.0.0.1:18090
	}

	# iroh-relay: /relay (WebSocket upgrade), /ping, /generate_204, /healthz.
	handle {
		reverse_proxy 127.0.0.1:13340 {
			flush_interval -1
		}
	}
}
