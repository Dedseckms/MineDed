# Copy to /opt/relay/.env. No secrets here.
# TCP ports are published on 127.0.0.1 only (Caddy proxies relay.dedseckms.ru to them).
# Forbidden: 53, 80, 443, 1053, 7890-7899, 8080, 9090. Drasl uses 25585.
HUB_PORT=18080
RELAY_HTTP_PORT=13340
# Subnet of the project bridge network (not 172.17/16, 172.19/16, 172.20/16, 172.30.42/24).
RELAY_SUBNET=172.30.43.0/24
# Public relay URL(s) handed to clients (comma separated).
HUB_RELAY_URLS=https://relay.dedseckms.ru
# Room TTL (seconds); a room stays alive while its host is connected to the WS.
HUB_ROOM_TTL_SECS=21600
HUB_MAX_ROOMS=200
HUB_MAX_ROOMS_PER_USER=3

# Update mirror: GitHub repo slug (owner/name) whose latest release is mirrored to
# https://relay.dedseckms.ru/updates/ every UPDATES_INTERVAL_SECS. Empty = idle.
GITHUB_REPO=Dedseckms/MineDed
UPDATES_PORT=18090
# Website mineded.dedseckms.ru (must match caddy/site.caddy).
SITE_PORT=18091
UPDATES_BASE_URL=https://relay.dedseckms.ru/updates
UPDATES_INTERVAL_SECS=1800
UPDATES_MAX_TOTAL_MB=1024

# QUIC address discovery: set QAD=1 after Caddy has a cert for relay.dedseckms.ru
# and the router forwards UDP QAD_PORT -> 192.168.31.83.
QAD=0
QAD_PORT=7842
CADDY_UID=996
CADDY_GID=988
CADDY_CERT_DIR=/var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/relay.dedseckms.ru
