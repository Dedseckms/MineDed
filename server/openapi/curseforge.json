{
  "description": "Restricted Minecraft-only CurseForge broker. Base: /api/v1/catalog/curseforge. API key only from VPS environment CURSEFORGE_API_KEY, redacted in Debug/logs; no client key/header accepted. Unknown query keys and all unlisted routes/methods rejected. Fixed upstream https://api.curseforge.com/v1, no redirects, no user-controlled upstream URLs. Force game432 and validate returned project/file ownership/game. JSON streamed cap4MiB, timeout15s, global concurrency8, per-IP60/min. Bounded response cache <=64entries/16MiB TTL60s; only successful public metadata cached. Response data uses official envelopes. GET files/{fileId} maps to fixed POST mods/files {fileIds:[id]}, returning single data object. Downloads use existing Downloader against permitted CDN URLs; no API key required. No deployment automatically authorized.",
  "paths": {
  "/mods": {
    "post": {
      "tags": [
        "catalog"
      ],
      "operationId": "curseforgeModsBatch",
      "summary": "Read-only bounded Minecraft metadata batch",
      "security": [],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "modIds"
              ],
              "properties": {
                "modIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 50,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  }
                }
              },
              "additionalProperties": false
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Official data envelope with Minecraft-only objects; no credentials",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "400": {
          "description": "Invalid batch or unknown body fields"
        },
        "413": {
          "description": "Request exceeds 4 KiB"
        },
        "429": {
          "description": "Rate limited; Retry-After seconds <=60",
          "headers": {
            "Retry-After": {
              "schema": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              }
            }
          }
        },
        "502": {
          "description": "Sanitized invalid upstream response"
        },
        "503": {
          "description": "Broker not configured"
        }
      }
    }
  },
