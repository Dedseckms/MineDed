# Server-only environment: copy values into the owner's secret store, never commit.
HUB_CHAT_DIR=/data/chat
HUB_DRASL_ADMIN_URL=http://mineup-skin-drasl:25585/drasl/api/v3
HUB_DRASL_ADMIN_TOKEN=
# Destinations must exist, be separate from source, and be writable by hub uid 65534.
# Object storage uses an externally configured durable S3-compatible filesystem mount.
HUB_CHAT_NEW_DISK_DIR=
HUB_CHAT_OBJECT_STORAGE_DIR=
# Host-side scheduled jobs: HUB_CHAT_DIR points at the host mount of hub_chat.
CHAT_BACKUP_DEST=
CHAT_TELEGRAM_BOT_TOKEN=
CHAT_TELEGRAM_OWNER_ID=
